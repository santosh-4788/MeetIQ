{
  "openapi": "3.1.1",
  "info": {
    "title": "OneInsure Connect Integration API",
    "description": "Create and manage OneInsure Connect meetings from your own portal: instant or scheduled meetings, PLVC meetings with a Prarambh Main ID,\nparticipant join links, meeting status, the meeting completion report, recording metadata and secure recording downloads, and webhooks.\n\nAuthentication: send your integration's API key as `Authorization: Bearer <key>` (or `X-Api-Key: <key>`). Each key belongs to one\nintegration and only ever sees that integration's meetings and recordings. Scopes decide which operations a key may call.\nErrors are application/problem+json with a machine-readable `code`. Rate limits are per integration (HTTP 429 with Retry-After).\nTimes are ISO-8601 in India Standard Time (+05:30).",
    "version": "v1"
  },
  "servers": [
    {
      "url": "https://www.oneinsure.com/meet",
      "description": "OneInsure Connect"
    }
  ],
  "paths": {
    "/api/ext/v1/me": {
      "get": {
        "tags": [
          "OneInsure Connect integration API"
        ],
        "summary": "Who am I: the calling integration, its scopes and rate limit.",
        "operationId": "GetIntegration",
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtMe"
                }
              }
            }
          }
        }
      }
    },
    "/api/ext/v1/meetings": {
      "post": {
        "tags": [
          "OneInsure Connect integration API"
        ],
        "summary": "Create an instant or scheduled meeting and get its links.",
