  "components": {
    "schemas": {
      "ExtAttendance": {
        "required": [
          "joinedAt",
          "leftAt",
          "seconds"
        ],
        "type": "object",
        "properties": {
          "joinedAt": {
            "type": "string",
            "format": "date-time"
          },
          "leftAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "seconds": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "ExtCancelInput": {
        "required": [
          "reason"
        ],
        "type": "object",
        "properties": {
          "reason": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ExtCreateMeetingInput": {
        "required": [
          "category",
          "meetingType",
          "meetingTitle",
          "purpose",
          "description",
          "prarambhMainId",
          "host",
          "participants",
          "startTime",
          "durationMinutes",
          "audioOnly",
          "waitingRoomEnabled",
          "recordingPolicy",
          "externalReference"
        ],
        "type": "object",
        "properties": {
          "category": {
            "type": [
              "null",
              "string"
            ]
          },
          "meetingType": {
            "type": [
              "null",
              "string"
            ]
          },
          "meetingTitle": {
            "type": [
              "null",
              "string"
            ]
          },
          "purpose": {
            "type": [
              "null",
              "string"
