{
  "Recorder": {
    "Environment": "Development",
    "LiveKit": {
      "Url": "ws://127.0.0.1:7880",
      "TokenTtlMinutes": 10
    },
    "Browser": { "Channel": "msedge", "Headless": true },
    "Layout": {
      "DistPath": "../../../../../../recording/layout/dist",
      "Width": 1280,
      "Height": 720,
      "Fps": 25,
      "VideoBitsPerSecond": 2500000,
      "AudioBitsPerSecond": 128000,
      "TimesliceMs": 2000,
      "VideoCodec": "vp8",
      "TimeZone": "Asia/Kolkata"
    },
    "Storage": {
      "SpoolRoot": "../../../../../../recording/spool",
      "OutputRoot": "../../../../../../recording/output",
      "KeepSpoolAfterSuccess": true
    },
    "Ffmpeg": { "FfmpegPath": "ffmpeg", "FfprobePath": "ffprobe", "X264Preset": "veryfast", "Crf": 23, "AudioBitrateKbps": 128, "BelowNormalPriority": true },
    "Health": { "PollSeconds": 2, "StallSeconds": 12, "MaxRestarts": 5, "MaxDurationMinutes": 240, "DurationTolerancePercent": 3, "DurationToleranceMinSeconds": 5 }
  },

  "_RecordingPolicyNote": "PLACEHOLDER policy for development. Wording, retention and legal hold are NOT approved. Customer recording must stay disabled in Pilot/Production until legal/compliance approval (enforced by RecordingPolicyGate).",
  "RecordingPolicy": {
    "ApprovalStatus": "PendingLegalApproval",
    "CustomerRecordingEnabled": false,
    "InternalRecordingEnabled": false,
    "CustomerMeetingRecording": "Optional",
    "InternalMeetingRecording": "Optional",
    "ConsentNoticeVersion": "PLACEHOLDER-0",
    "ConsentNoticeText": "[PLACEHOLDER – NOT APPROVED BY LEGAL] This meeting will be recorded. Final wording to be provided by the OneInsure legal/compliance team.",
    "ConsentRequiredFromAllParticipants": true,
    "StopRecordingOnConsentWithdrawal": true,
    "ActionOnRetentionExpiry": "ReviewOnly",
    "LegalHoldEnabled": true,
    "OwnerCanPlay": true,
    "OwnerCanDownload": false,
    "TeamLeaderCanPlayTeamRecordings": true,
    "SignedUrlTtlSeconds": 300
  }
}
