{
  "_comment": "No secrets here. ConnectionStrings:OneInsure comes from user secrets (dev) or the environment variable ConnectionStrings__OneInsure (server).",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Security": {
    "SessionIdleMinutes": 30,
    "SessionAbsoluteHours": 12,
    "RememberMeDays": 7,
    "LockoutThreshold": 5,
    "LockoutMinutes": 15,
    "PasswordResetMinutes": 30,
    "CookieSecure": true,
    "AllowedOrigins": []
  },
  "PublicEndpoints": {
    "WebBaseUrl": "https://meet.oneinsure.com"
  },
  "Email": {
    "_comment": "Delivery via OneInsure's mail procedure (Util_SendEmail2). Off until configured. Procedure may be a three-part name, e.g. [MailDb].dbo.Util_SendEmail2.",
    "Enabled": false,
    "Procedure": "dbo.Util_SendEmail2",
    "ConnectionStringName": "OneInsure",
    "From": "support@oneinsure.com",
    "ReplyTo": "support@oneinsure.com",
    "DisplayName": "OneInsure Connect",
    "TemplateId": null,
    "PurposeId": null,
    "LogoUrl": "https://www.oneinsure.com/assets/cmn/logo-white.png",
    "SupportEmail": "it.support@oneinsure.com",
    "RedirectAllTo": null,
    "PollSeconds": 15,
    "BatchSize": 20,
    "MaxAttempts": 5
  },
  "Meetings": {
    "DefaultTimeZone": "Asia/Kolkata",
    "MaxDurationHours": 8,
    "MaxCalendarDays": 62,
    "JoinEarlyMinutes": 15,
    "JoinLateMinutes": 60,
    "JoinPermitPerMinute": 30,
    "WaitingRoomPermitPerMinute": 180,
    "InvitationGraceDays": 1
  },
  "LiveKit": {
    "_comment": "Video SFU. ApiKey/ApiSecret ONLY via user secrets (dev) or environment variables LiveKit__ApiKey / LiveKit__ApiSecret (server). Without them the API starts and joining answers 503.",
    "PublicUrl": "",
    "ApiUrl": "",
    "TokenTtlMinutes": 10,
    "DepartureTimeoutSeconds": 120,
    "WebhookListenUrl": null
  },
  "Reminders": {
    "Enabled": true,
    "OffsetsMinutes": [ 1440, 60, 15 ],
    "PollSeconds": 30,
    "BatchSize": 50,
    "MaxAttempts": 5,
    "LeaseSeconds": 120
  },
  "Recording": {
    "_comment": "Phase 5 recording. The R2 recorder is a PROOF OF CONCEPT (headless Microsoft Edge + FFmpeg, separate process). StorageRoot/SpoolRoot must be outside the web root; recordings are only served through short-lived signed URLs. Environment Pilot/Production refuses recording under an unconfirmed policy.",
    "Environment": "Production",
    "StorageRoot": "",
    "SpoolRoot": "",
    "RecorderExePath": "",
    "FfmpegPath": "ffmpeg",
    "FfprobePath": "ffprobe",
    "EdgePath": null,
    "LayoutDistPath": null,
    "LiveKitUrl": null,
    "WorkerEnabled": true,
    "PollSeconds": 3,
    "LeaseSeconds": 60,
    "StartTimeoutSeconds": 120,
    "StopTimeoutSeconds": 300,
    "MaxDurationMinutes": 240,
    "MaxLaunches": 3,
    "KeepSpoolAfterSuccess": false,
    "RetentionEnabled": true,
    "RetentionPollMinutes": 60
  }
}
