<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OneInsure.Connect.Api</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Connection strings live in user secrets (dev) or environment variables (server), never in appsettings. -->
    <UserSecretsId>oneinsure-connect-api-7c1e0b52</UserSecretsId>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- Pin: SqlClient pulls System.Security.Cryptography.Pkcs 9.0.18 (CVE-2026-84008, GHSA-846f-f764-76mx / GHSA-2fmv-rv2c-59x7). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- Recording policy gate and media verification are shared with the R2 recorder. -->
    <ProjectReference Include="..\OneInsure.Connect.Domain\OneInsure.Connect.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OneInsure.Connect.Api.Tests" />
  </ItemGroup>

</Project>
