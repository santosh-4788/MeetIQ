<?xml version="1.0" encoding="utf-8"?>
<!--
  OneInsure Connect - IIS site (physical path: <InstallRoot>\web).
  Requires (all free, from Microsoft): IIS with "WebSocket Protocol", URL Rewrite 2.1, Application Request Routing 3.0
  (proxy enabled at server level - install-oneinsure-connect.ps1 does that).

  One public origin (https://<domain>) for everything, exactly like the tested LAN mode:
    /api/*  -> API (Kestrel, Windows service OneInsureConnectApi) on http://127.0.0.1:5000 (loopback only)
    /rtc*   -> LiveKit signalling (WebSocket, service OneInsureConnectVideo) on http://127.0.0.1:7880 (loopback only)
    else    -> the web app (static files; unknown paths serve index.html for client-side routes)
  Media (WebRTC) does not pass through IIS: browsers connect to LiveKit directly on TCP 7881 / UDP 7882.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Redirect to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="API" stopProcessing="true">
          <match url="^api/(.*)" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:5000/api/{R:1}" />
        </rule>
        <rule name="LiveKit signalling" stopProcessing="true">
          <match url="^rtc(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:7880/rtc{R:1}" />
        </rule>
        <rule name="Web app routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>
    <staticContent>
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="no-referrer" />
        <add name="Permissions-Policy" value="camera=(self), microphone=(self), display-capture=(self), geolocation=(), payment=()" />
      </customHeaders>
    </httpProtocol>
    <security>
      <requestFiltering removeServerHeader="true" />
    </security>
  </system.webServer>
  <!-- Built files have content hashes in their names: cache for a year. index.html must always be re-checked. -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
