<?xml version="1.0" encoding="utf-8"?>
<!--
  OneInsure Connect (MeetIQ) - test deployment as an IIS sub-application at /meet under site v2.oneinsure.com
  (physical path: frontend\dist). <clear /> is required because the parent site's web.config defines its own
  catch-all rewrite rules (Angular SPA fallback) that would otherwise also apply here and break this app.
  This file lives in frontend/public so `vite build` copies it into dist/ on every build (vite build wipes
  dist/ and does not otherwise preserve files placed there by hand).

    /meet/api/*  -> API (Kestrel, Windows service MeetIQApi) on http://127.0.0.1:58100 (loopback only)
    /meet/rtc*   -> LiveKit signalling on http://127.0.0.1:7880 (loopback only; video server not yet installed)
    else         -> the web app (static files; unknown paths serve index.html for client-side routes)
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <clear />
        <rule name="MeetIQ Redirect to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="MeetIQ API" stopProcessing="true">
          <match url="^api/(.*)" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:58100/api/{R:1}" />
        </rule>
        <rule name="MeetIQ LiveKit signalling" stopProcessing="true">
          <match url="^rtc(.*)" />
          <!-- ARR's WebSocket proxy mishandles the permessage-deflate compression extension (handshake succeeds,
               connection drops once compressed frames flow): strip the client's offer so LiveKit never negotiates it. -->
          <serverVariables>
            <set name="HTTP_SEC_WEBSOCKET_EXTENSIONS" value="" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:7880/rtc{R:1}" />
        </rule>
        <rule name="MeetIQ web app routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/meet/index.html" />
        </rule>
      </rules>
    </rewrite>
    <staticContent>
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <!-- Background blur (optional meeting feature): MediaPipe runtime and segmentation model, self-hosted under /meet/mediapipe. -->
      <!-- Android app download (/meet/app/OneInsureConnect.apk, 19 Nov 2026). -->
      <remove fileExtension=".apk" />
      <mimeMap fileExtension=".apk" mimeType="application/vnd.android.package-archive" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".wasm" />
      <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
      <remove fileExtension=".tflite" />
      <mimeMap fileExtension=".tflite" mimeType="application/octet-stream" />
    </staticContent>
    <!-- LiveKit's /rtc connection URL carries a long signed JWT access token (plus extra params on the newer
         client protocol's preflight /rtc/v1/validate check) that exceeds IIS's default 2048-char query string
         limit, which IIS rejects with 404.15 before the request ever reaches our rewrite rules. Scoped to this
         application only. -->
    <security>
      <requestFiltering>
        <requestLimits maxQueryString="16384" maxUrl="16384" />
      </requestFiltering>
      <!-- The parent site (v2.oneinsure.com) has Basic and Windows authentication explicitly enabled alongside
           anonymous auth (likely for a different sub-application, e.g. /reports) - inherited here otherwise,
           causing the native browser credential prompt on this app's own pages including guest meeting links.
           This app is anonymous-only; employee sign-in is handled by the API, not IIS. -->
      <authentication>
        <anonymousAuthentication enabled="true" />
        <basicAuthentication enabled="false" />
        <windowsAuthentication enabled="false" />
      </authentication>
    </security>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="no-referrer" />
        <add name="Permissions-Policy" value="camera=(self), microphone=(self), display-capture=(self), geolocation=(), payment=()" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
